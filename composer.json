{
	"name": "webtions/custom-favicon",
	"type": "wordpress-plugin",
	"description": "Add a custom favicon to your WordPress site from the admin.",
	"keywords": ["WordPress", "Plugin", "favicon"],
	"homepage": "https://github.com/webtions/custom-favicon",
	"license": "GPL-3.0-or-later",
	"require": {
	  "php": ">=7.4"
	},
	"require-dev": {
	  "php-parallel-lint/php-parallel-lint": "^1.3",
	  "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
	  "wp-coding-standards/wpcs": "^3.0",
	  "phpstan/phpstan": "^1.11",
	  "szepeviktor/phpstan-wordpress": "^1.3"
	},
	"scripts": {
	  "lint": "parallel-lint --exclude vendor .",
	  "standards:check": "phpcs",
	  "standards:fix": "phpcbf",
	  "analyze": "php -d memory_limit=512M vendor/bin/phpstan analyze"
	},
	"config": {
	  "allow-plugins": {
		"dealerdirect/phpcodesniffer-composer-installer": true
	  }
	}
  }
